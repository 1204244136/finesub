# /etc/systemd/system/finesub-share.service
# 共享知识库服务（deploy/share-server/README.md）。口令文件放在 /etc/finesub-share/，
# 只让 root 可读（chmod 600）；systemd 用 LoadCredential 交给服务，口令不进命令行、
# 也不进这个文件——命令行（/proc/<pid>/cmdline）对同机所有用户可读。
[Unit]
Description=FineSub knowledge share server
After=network.target

[Service]
Type=simple
User=finesub
Group=finesub
Environment=PYTHONUNBUFFERED=1
LoadCredential=maintainer-token:/etc/finesub-share/maintainer-token
# 签快照（可选，见 docs/manual/share-server.md「签名密钥」）：取消下面一行和 ExecStart 里对应参数的注释
# LoadCredential=signing-key:/etc/finesub-share/signing.key
ExecStart=/usr/bin/python3 -m finesub.llm.knowledge.share.server \
    --root /var/lib/finesub-share --port 8787 \
    --maintainer-token-file %d/maintainer-token
#   --signing-key-file %d/signing-key
Restart=on-failure
RestartSec=3

# hardening: 服务只该碰自己的数据目录
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finesub-share
PrivateTmp=true

[Install]
WantedBy=multi-user.target
