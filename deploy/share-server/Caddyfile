# /etc/caddy/Caddyfile — TLS 与对外暴露归 Caddy，服务本体只听 127.0.0.1:8787。
# 把 share.example.com 换成你的域名；Caddy 自动申请/续期证书。
share.example.com {
	reverse_proxy 127.0.0.1:8787 {
		# 服务只接受以 localhost 相称的请求（防 DNS 重绑定），所以转发时用上游地址当 Host。
		header_up Host {upstream_hostport}
	}

	# 请求体上限与服务端一致（服务端另有 2MB 硬校验，这里先挡掉大流量）
	request_body {
		max_size 2MB
	}

	# ⚠ 公开部署前必做：按 IP 限速。应用层配额是全局的（每天 20 个注册名额），挡不住一个人
	# 每天先把名额用完。需要 caddy-ratelimit 插件（xcaddy build --with
	# github.com/mholt/caddy-ratelimit），装好后取消注释。
	# rate_limit {
	#	zone share_by_ip {
	#		key {remote_host}
	#		events 30
	#		window 1m
	#	}
	# }
}
